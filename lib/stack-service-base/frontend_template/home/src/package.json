{
  "name": "${service_name}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "preview": "npm run build:preview && vite preview --host 0.0.0.0 --mode preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
